{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digestif-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CIRCLE_ROOT": "sha256:004169dcdcd761ec470e2279c832a3f5684fc25e97bd5d3766397de373f53ba3",
    "MAX_ENVELOPE_BYTES": "65536",
    "MAX_APPENDS_PER_DEVICE_PER_DAY": "500",
    "MAX_PAGE_SIZE": "500",
    "SKEW_SECONDS": "3600",
    "MAILER": "0",
    "MAIL_FROM": "Digestif <digest@mail.digestif.io>"
  },
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digestif-relay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Two deployments of the same Worker (docs/design.md "Two relays to start"). wrangler does not
  // inherit vars, assets or bindings into an environment, so each one repeats them.
  // Secret values are never in this file; each environment lists the names it needs under
  // "secrets.required" and they are set with `wrangler secret put <NAME> --env <environment>`.
  "env": {
    // dinners: the mailer, in the project's Cloudflare account, at dinners.digestif.io.
    "dinners": {
      "name": "digestif-dinners",
      "secrets": { "required": ["RELAY_SEALING_KEY", "RESEND_API_KEY"] },
      "routes": [{ "pattern": "dinners.digestif.io", "custom_domain": true }],
      "vars": {
        // The founding dinner's hash: the root of the circle both relays serve. The ROOT_HASH
        // environment variable overrides it at deploy time.
        "CIRCLE_ROOT": "sha256:36b75adb36d9b9a4c30af96a4fe745ecb7ddfa03089906ee41ee235115fc5533",
        "MAX_ENVELOPE_BYTES": "65536",
        "MAX_APPENDS_PER_DEVICE_PER_DAY": "500",
        "MAX_PAGE_SIZE": "500",
        "SKEW_SECONDS": "3600",
        "MAILER": "1",
        "MAIL_FROM": "Digestif <digest@mail.digestif.io>",
        "RELAY_URL": "https://dinners.digestif.io"
      },
      "assets": {
        "directory": "./app",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Replaced by scripts/deploy.sh from `wrangler d1 create digestif-dinners`.
          "database_name": "digestif-dinners",
          "database_id": "e04c58e6-c628-4801-a31f-221fcb9fdb04",
          "migrations_dir": "migrations"
        }
      ]
    },
    // dinners-roman: Roman's own account; never mails, so it holds no mail-provider secret.
    "dinners-roman": {
      "name": "dinners",
      "secrets": { "required": ["RELAY_SEALING_KEY"] },
      "vars": {
        // The founding dinner's hash: the root of the circle both relays serve. The ROOT_HASH
        // environment variable overrides it at deploy time.
        "CIRCLE_ROOT": "sha256:36b75adb36d9b9a4c30af96a4fe745ecb7ddfa03089906ee41ee235115fc5533",
        "MAX_ENVELOPE_BYTES": "65536",
        "MAX_APPENDS_PER_DEVICE_PER_DAY": "500",
        "MAX_PAGE_SIZE": "500",
        "SKEW_SECONDS": "3600",
        "MAILER": "0",
        "MAIL_FROM": "Digestif <digest@mail.digestif.io>",
        "RELAY_URL": "https://dinners.rcherkasov.workers.dev"
      },
      "assets": {
        "directory": "./app",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Replaced by scripts/deploy.sh from `wrangler d1 create digestif-dinners-roman`.
          "database_name": "digestif-dinners-roman",
          "database_id": "26e4568b-f457-46c6-af40-43a5d7880fcf",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
