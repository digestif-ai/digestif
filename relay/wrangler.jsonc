{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digestif-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CIRCLE_ROOT": "sha256:004169dcdcd761ec470e2279c832a3f5684fc25e97bd5d3766397de373f53ba3",
    "MAX_ENVELOPE_BYTES": "65536",
    "MAX_APPENDS_PER_DEVICE_PER_DAY": "500",
    "MAX_PAGE_SIZE": "500",
    "SKEW_SECONDS": "3600",
    "MAILER": "0",
    "MAIL_FROM": "Digestif <digest@mail.digestif.io>"
  },
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digestif-relay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Two deployments of the same Worker (docs/design.md "Two relays to start"). wrangler does not
  // inherit vars, assets or bindings into an environment, so each one repeats them.
  // Secret values are never in this file; each environment lists the names it needs under
  // "secrets.required" and they are set with `wrangler secret put <NAME> --env <environment>`.
  "env": {
    // relay-1: the mailer, in the project's Cloudflare account, at relay1.digestif.io.
    "relay-1": {
      "name": "digestif-relay-1",
      "secrets": { "required": ["RELAY_SEALING_KEY", "RESEND_API_KEY"] },
      "routes": [{ "pattern": "relay1.digestif.io", "custom_domain": true }],
      "vars": {
        // The founding dinner's hash, sha256:<64 hex>. Empty on purpose: scripts/deploy.sh refuses
        // until it is set here or in the ROOT_HASH environment variable (the Worker reads it as CIRCLE_ROOT).
        "CIRCLE_ROOT": "",
        "MAX_ENVELOPE_BYTES": "65536",
        "MAX_APPENDS_PER_DEVICE_PER_DAY": "500",
        "MAX_PAGE_SIZE": "500",
        "SKEW_SECONDS": "3600",
        "MAILER": "1",
        "MAIL_FROM": "Digestif <digest@mail.digestif.io>",
        "RELAY_URL": "https://relay1.digestif.io"
      },
      "assets": {
        "directory": "./app",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Replaced by scripts/deploy.sh from `wrangler d1 create digestif-relay-1`.
          "database_name": "digestif-relay-1",
          "database_id": "761aa5c5-9e92-44b5-9270-dd84d8b165b8",
          "migrations_dir": "migrations"
        }
      ]
    },
    // relay-2: Roman's own account; never mails, so it holds no mail-provider secret.
    "relay-2": {
      "name": "digestif-relay-2",
      "secrets": { "required": ["RELAY_SEALING_KEY"] },
      "vars": {
        // The founding dinner's hash, sha256:<64 hex>. Empty on purpose: scripts/deploy.sh refuses
        // until it is set here or in the ROOT_HASH environment variable (the Worker reads it as CIRCLE_ROOT).
        "CIRCLE_ROOT": "",
        "MAX_ENVELOPE_BYTES": "65536",
        "MAX_APPENDS_PER_DEVICE_PER_DAY": "500",
        "MAX_PAGE_SIZE": "500",
        "SKEW_SECONDS": "3600",
        "MAILER": "0",
        "MAIL_FROM": "Digestif <digest@mail.digestif.io>",
        "RELAY_URL": "https://REPLACE-WITH-RELAY-2-URL.example"
      },
      "assets": {
        "directory": "./app",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Replaced by scripts/deploy.sh from `wrangler d1 create digestif-relay-2`.
          "database_name": "digestif-relay-2",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
