opam-version: "2.0"
synopsis: "The Digestif node: one binary per member machine"
authors: ["Michael Bryzek" "Roman Cherkasov"]
license: "MIT"
homepage: "https://github.com/mbryzek/digestif"
bug-reports: "https://github.com/mbryzek/digestif/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17" & >= "3.17"}
  "mirage-crypto-ec" {>= "2.0"}
  "mirage-crypto-rng" {>= "2.0"}
  "digestif" {>= "1.2"}
  "yojson" {>= "2.0"}
  "cmdliner" {>= "1.3"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
