(library
 (name digestif_web)
 (libraries
  digestif-node.core
  digestif-node.daily
  digestif_mail
  re
  sqlite3
  yojson
  unix))

; ui/ is ui/build, copied here by ci/build.sh before the node builds; it is not checked in. Dune
; skips directories whose names start with an underscore, and SvelteKit's build keeps its
; scripts under _app, so the subdir stanza lets them in.

(subdir
 ui
 (dirs :standard _app))

(rule
 (target assets.ml)
 (deps
  (source_tree ui))
 (action
  (with-stdout-to
   %{target}
   (run embed/embed.exe ui))))
