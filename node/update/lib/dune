; The release signer set and the version this build is, embedded at compile time. The version is
; the release tag the build was made from, which ci/version.sh reads and every build script passes
; in DIGESTIF_VERSION; a build given none (a plain `dune build`, an untagged checkout) is 0.0.0,
; which every release is newer than (docs/releases.md, Cutting a release).

(rule
 (targets trust_root_data.ml)
 (deps ../release-signers.json)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let signers_json = {json|")
    (cat ../release-signers.json)
    (echo "|json}\nlet version = {v|")
    (echo %{env:DIGESTIF_VERSION=0.0.0})
    (echo "|v}\n")))))

(library
 (name digestif_update)
 (public_name digestif-node.update)
 (libraries digestif-node.core yojson unix threads.posix)
 (foreign_stubs
  (language c)
  (names keychain_stubs))
 (c_library_flags
  (:include keychain_flags.sexp))
 (flags
  (:standard -open Digestif_core)))

; The signing job's Keychain (keychain_stubs.c) links Apple's Security framework on a Mac; on any
; other system the stubs answer that the Keychain is macOS's and link nothing.

(rule
 (targets keychain_flags.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (with-stdout-to
   %{targets}
   (echo "(-Wl,-framework,Security -Wl,-framework,CoreFoundation)"))))

(rule
 (targets keychain_flags.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (with-stdout-to
   %{targets}
   (echo "()"))))

; The macOS service's launcher (../../launcher), embedded with a digest of its source so the node
; writes it to its fixed path only when that source changes (launcher.ml). It is a macOS program:
; on any other system the node embeds no bytes, and the digest alone. DIG-492

(rule
 (targets launcher_data.ml)
 (enabled_if
  (= %{system} macosx))
 (deps
  ../../launcher/digestif_launcher.exe
  (:source ../../launcher/digestif_launcher.ml ../../launcher/dune))
 (action
  (with-stdout-to
   %{targets}
   (run
    ../../launcher/embed/embed.exe
    ../../launcher/digestif_launcher.exe
    %{source}))))

(rule
 (targets launcher_data.ml)
 (enabled_if
  (<> %{system} macosx))
 (deps
  (:source ../../launcher/digestif_launcher.ml ../../launcher/dune))
 (action
  (with-stdout-to
   %{targets}
   (run ../../launcher/embed/embed.exe - %{source}))))
