; The release signer set and the version this build is, embedded at compile time.

(rule
 (targets trust_root_data.ml)
 (deps ../release-signers.json ../../VERSION)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let signers_json = {json|")
    (cat ../release-signers.json)
    (echo "|json}\nlet version = {v|")
    (echo %{read-lines:../../VERSION})
    (echo "|v}\n")))))

(library
 (name digestif_update)
 (public_name digestif-node.update)
 (libraries
  mirage-crypto-ec
  mirage-crypto-rng.unix
  digestif.c
  yojson
  unix))
