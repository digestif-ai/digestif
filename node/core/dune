(library
 (name digestif_core)
 (public_name digestif-node.core)
 (libraries
  digestif
  mirage-crypto-ec
  mirage-crypto-rng
  mirage-crypto-rng.unix
  sqlite3
  yojson
  unix
  threads.posix))

(rule
 (target bip39_words.ml)
 (deps bip39_english.txt)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let raw = {words|")
    (cat bip39_english.txt)
    (echo "|words}\n")))))

; The release signer set this build was made with (node/update/release-signers.json): the set the
; fold starts a circle founded at a dinner from (Fold.release_signers), as a relay starts from its
; build's RELEASE_SIGNERS. Digestif_update.Trust_root embeds the same file for releases.

(rule
 (target release_signers_data.ml)
 (deps ../update/release-signers.json)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let json = {json|")
    (cat ../update/release-signers.json)
    (echo "|json}\n")))))
