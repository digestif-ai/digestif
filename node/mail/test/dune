(test
 (name test_mail)
 (deps
  (env_var CI_ALCOTEST_LISTS)
  (env_var CI_SLOW_SPECS)
  (env_var CI_ALCOTEST_RERUN))
 (modules test_mail)
 (libraries
  digestif-node.core
  digestif-node.mail
  alcotest
  ci_alcotest
  yojson))

(executable
 (name vectors)
 (modules vectors)
 (libraries digestif-node.core digestif-node.mail yojson))

(rule
 (alias runtest)
 (deps
  ../webcrypto/mail.mjs
  ../webcrypto/mail.test.mjs
  (:vectors vectors.json))
 (action
  (setenv
   DIGESTIF_MAIL_VECTORS
   %{vectors}
   (run node --test ../webcrypto/mail.test.mjs))))

(rule
 (alias runtest)
 (action
  (diff vectors.json vectors.gen.json)))

(rule
 (with-stdout-to
  vectors.gen.json
  (run ./vectors.exe)))
