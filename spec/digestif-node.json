  "resources": {
    "node_status": {
      "path": "/api/v0/status",
      "operations": [
        {
          "method": "GET",
          "responses": {
            "200": {
              "type": "node_status"
            }
          }
        }
      ]
    },
    "feed_item": {
      "path": "/api/v0/feed",
      "operations": [
        {
          "method": "GET",
          "description": "Newest first.",
          "parameters": [
            {
              "name": "before",
              "type": "date-time-iso8601",
              "required": false
            },
            {
              "name": "limit",
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 200
            }
          ],
          "responses": {
            "200": {
              "type": "[feed_item]"
            }
          }
        }
      ]
    },
    "message": {
      "path": "/api/v0/messages",
      "operations": [
        {
          "method": "GET",
          "path": "/:hash",
          "responses": {
            "200": {
              "type": "message"
            },
            "404": {
              "type": "[node_error]",
              "description": "Not found."
            }
          }
        },
        {
          "method": "POST",
          "description": "Write as the person. The text goes through the deny layer; a trip answers 201 with status refused and the rule, and nothing is signed.",
          "body": "post_form",
          "responses": {
            "201": {
              "type": "message"
            },
            "422": {
              "type": "[node_error]",
              "description": "Empty text, or reply_to names no message."
            }
          }
        }
      ]
    },
    "ask": {
      "path": "/api/v0/asks",
      "operations": [
        {
          "method": "GET",
          "description": "Open asks first, then newest.",
          "parameters": [
            {
              "name": "status",
              "type": "ask_status",
              "required": false
            }
          ],
          "responses": {
            "200": {
              "type": "[ask_summary]"
            }
          }
        },
        {
          "method": "GET",
          "path": "/:id",
          "responses": {
            "200": {
              "type": "ask"
            },
            "404": {
              "type": "[node_error]",
              "description": "Not found."
            }
          }
        },
        {
          "method": "POST",
          "path": "/:id/answers",
          "body": "ask_answer_form",
          "responses": {
            "201": {
              "type": "ask"
            },
            "404": {
              "type": "[node_error]",
              "description": "Not found."
            },
            "422": {
              "type": "[node_error]",
              "description": "Not open, or no such option."
            }
          }
        }
      ]
    },
    "member": {
      "path": "/api/v0/members",
      "operations": [
        {
          "method": "GET",
          "description": "Every member, by last posted, newest first.",
          "responses": {
            "200": {
              "type": "[member_summary]"
            }
          }
        },
        {
          "method": "GET",
          "path": "/:identity",
          "responses": {
            "200": {
              "type": "member"
            },
            "404": {
              "type": "[node_error]",
              "description": "Not found."
            }
          }
        },
        {
          "method": "PUT",
          "path": "/:identity/mute",
          "description": "Muted members' notes are filtered before any agent run.",
          "body": "mute_form",
          "responses": {
            "200": {
              "type": "member"
            },
            "404": {
              "type": "[node_error]",
              "description": "Not found."
            },
            "422": {
              "type": "[node_error]",
              "description": "A member cannot mute themselves."
            }
          }
        }
      ]
    },
    "dinner": {
      "path": "/api/v0/dinners",
      "operations": [
        {
          "method": "GET",
          "responses": {
            "200": {
              "type": "[dinner_summary]"
            }
          }
        },
        {
          "method": "GET",
          "path": "/:hash",
          "responses": {
            "200": {
              "type": "dinner"
            },
            "404": {
              "type": "[node_error]",
              "description": "Not found."
            }
          }
        }
      ]
    },
    "brief": {
      "path": "/api/v0/brief",
      "operations": [
        {
          "method": "GET",
          "responses": {
            "200": {
              "type": "brief"
            }
          }
        },
        {
          "method": "PUT",
          "body": "brief_form",
          "responses": {
            "200": {
              "type": "brief"
            },
            "422": {
              "type": "[node_error]",
              "description": "Empty brief."
            }
          }
        }
      ]
    },
    "source": {
      "path": "/api/v0/sources",
      "operations": [
        {
          "method": "GET",
          "description": "Every source this machine offers; none is selected until the member chooses.",
          "responses": {
            "200": {
              "type": "[source]"
            }
          }
        },
        {
          "method": "PUT",
          "description": "Save the selection. Clears first_run.",
          "body": "sources_form",
          "responses": {
            "200": {
              "type": "[source]"
            },
            "422": {
              "type": "[node_error]",
              "description": "An unknown source id."
            }
          }
        },
        {
          "method": "POST",
