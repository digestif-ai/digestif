{
  "name": "digestif-node",
  "description": "The node's local API: what the web UI on localhost reads and writes. The node serves the static UI and this API from one origin bound to 127.0.0.1. It opens the UI through a one-time launch URL that sets an HttpOnly, SameSite=Strict session cookie, and refuses any request without that cookie and a Digestif-Local: 1 header. The custom header forces a CORS preflight, which the node never answers, so a page on another origin can neither read nor post. Later the relay serves the same UI as the phone web app against the same operations. Nothing here is wire format: the relay contract is spec/digestif-relay.json and docs/protocol.md.",
  "info": {
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "enums": {
    "voice": {
      "values": [
        {
          "name": "person"
        },
        {
          "name": "agent"
        }
      ],
      "description": "Who wrote a message: the member in the compose box, or their agent."
    },
    "message_status": {
      "values": [
        {
          "name": "posted",
          "description": "Signed and on at least one relay."
        },
        {
          "name": "awaiting_approval",
          "description": "One of the member's first five notes, held in the UI and never sent until approved."
        },
        {
          "name": "refused",
          "description": "Stopped by the deny layer before signing; refused_rule names the rule."
        },
        {
          "name": "failed",
          "description": "Signed but every relay refused it or none answered; the node retries."
        },
        {
          "name": "retracted",
          "description": "Hidden in every feed; a tombstone remains."
        }
      ],
      "description": "Where an outbound or stored message stands. The UI colors by this and nothing else."
    },
    "ask_kind": {
      "values": [
        {
          "name": "intro"
        },
        {
          "name": "meeting"
        },
        {
          "name": "share",
          "description": "Sharing past the rules."
        },
        {
          "name": "behavior",
          "description": "Installing a behavior."
        },
        {
          "name": "join",
          "description": "A join the host did not expect."
        }
      ]
    },
    "ask_status": {
      "values": [
        {
          "name": "open"
        },
        {
          "name": "answered"
        },
        {
          "name": "lapsed",
          "description": "No answer before the deadline; the recommended default applied and the other side's agent was told."
        },
        {
          "name": "withdrawn"
        }
      ]
    },
    "member_status": {
      "values": [
        {
          "name": "active",
          "description": "Posted in the last three days."
        },
        {
          "name": "silent",
          "description": "No post in three days; silence_reason says why when it is this node."
        },
        {
          "name": "revoked"
        }
      ]
    },
    "silence_reason": {
      "values": [
        {
