    "feed_item": {
      "path": "/api/v0/feed",
      "operations": [
        {
          "method": "GET",
          "description": "Newest first.",
          "parameters": [
            {
              "name": "before",
              "type": "date-time-iso8601",
              "required": false
            },
            {
              "name": "limit",
              "type": "integer",
