        {
          "name": "relay_rejecting"
        },
        {
          "name": "deny_refusing"
        }
      ]
    },
    "guest_status": {
      "values": [
        {
          "name": "invited"
        },
        {
          "name": "joined"
        },
        {
          "name": "expired"
        },
        {
          "name": "revoked"
        }
      ]
    },
    "source_kind": {
      "values": [
        {
          "name": "claude_code",
          "description": "Claude Code sessions under the listed directories."
